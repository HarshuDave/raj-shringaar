# Raj Shringaar Environment Configuration

# Admin Authentication
ADMIN_PASSWORD=Admin@rajShringaar

# Database (PostgreSQL - when ready)
# DATABASE_URL="postgresql://user:password@localhost:5432/raj_shringaar"

# Razorpay (Online Payments - when keys provided)
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."
# NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Cloudinary (Optional image hosting)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Security: Order Access Token HMAC Secret (Required in production, min 32 chars)
ORDER_TOKEN_SECRET="replace-with-a-secure-random-at-least-32-character-secret"

# Security: Distributed Rate Limiting via Upstash Redis (Serverless-compatible HTTP REST)
# Required in production across multi-instance Vercel serverless deployments.
# Falls back to local in-memory emergency rate limiting if not configured.
# UPSTASH_REDIS_REST_URL="https://your-upstash-redis-endpoint.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="replace-with-your-upstash-rest-token"

# Security: Customer Mobile OTP Authentication (Phase 5)
# Optional dedicated HMAC secret for hashing OTP challenges (min 32 chars; falls back to ORDER_TOKEN_SECRET)
# OTP_HASH_SECRET="replace-with-a-secure-random-at-least-32-character-otp-secret"

# SMS OTP Provider Selection ("msg91" | "fast2sms" | "twilio" — auto-detected if omitted)
# SMS_OTP_PROVIDER="msg91"

# Option A: MSG91 (Indian DLT-compliant SMS OTP)
# MSG91_AUTH_KEY="replace-with-msg91-auth-key"
# MSG91_TEMPLATE_ID="replace-with-dlt-approved-template-id"

# Option B: Fast2SMS (Indian SMS OTP)
# FAST2SMS_API_KEY="replace-with-fast2sms-api-key"
# FAST2SMS_DLT_SENDER_ID=""
# FAST2SMS_DLT_MESSAGE_ID=""

# Option C: Twilio Programmable SMS
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
# TWILIO_FROM_NUMBER="+1..."
